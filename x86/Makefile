# The x86-64 checker binary is built from:
#   ../commons/main.c     the trusted C harness (reads the input, maps the region, calls ca_start once)
#   checker.s             the compiled x86-64 checker (generated by the verified compiler, committed)
#   ../commons/pins.bin   the pin data, embedded by main.c via --embed-dir=../commons
#   ../commons/reasons.h  the messages of the abort reasons, included by main.c via -I../commons
# `make` needs only a C compiler with C23 `#embed` (GCC >= 15, Clang >= 19) and an x86-64 Linux
# assembler; no Lean.

CC ?= cc
CFLAGS ?= -O2

checker: ../commons/main.c checker.s ../commons/pins.bin ../commons/reasons.h
	$(CC) -std=gnu23 $(CFLAGS) -pthread -I../commons --embed-dir=../commons -o $@ ../commons/main.c checker.s

# A smoke test: the prelude (a small export) is accepted (exit 0), a malformed line is not
# (exit 3, `ok 1`).
PRELUDE = ../vendor/con-leche/pins/leanprover-lean4-v4.36.0.prelude.ndjson
check: checker
	./checker $(PRELUDE)
	printf 'not json\n' > checker-smoke.ndjson
	./checker checker-smoke.ndjson; test $$? = 3
	rm -f checker-smoke.ndjson
	@echo "make check: ok"

# Regenerate checker.s and pins.bin from the Lean sources.
regen:
	cd .. && python3 scripts/reasons.py
	cd .. && python3 scripts/asm_file.py

regen-check:
	cd .. && python3 scripts/reasons.py --check
	cd .. && python3 scripts/asm_file.py --check

clean:
	rm -f checker checker-smoke.ndjson

.PHONY: check regen regen-check clean
