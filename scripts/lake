#!/usr/bin/env python3
"""Wrapper around `lake` for the project-wide shared Lake artifact cache (DESIGN.md, "The shared Lake
artifact cache" and "Cache incident"). Use it instead of plain `lake` in every worktree, main tree too.

Reading: `LAKE_CACHE_DIR` points at `_tmp/lake-cache-v2` (shared through the `_tmp` symlink that
scripts/new-worktree.sh makes), so a build restores what any worktree has built, by hard link.

Writing (default; opt out with LAKE_ARTIFACT_CACHE=false) is GUARDED, because Lake has a time-of-check/
time-of-use gap (Cache incident, 2026-10-22): it hashes each module's source when the build STARTS but
Lean reads the file when the module is compiled, minutes later. A source edited, reverted, checked out,
merged or regenerated in between gets a cache entry "input hash of the old text -> olean of the new
text" (or the reverse), and every worktree with that text then restores the wrong olean, silently.
So a writing build here:
  1. holds a per-worktree lock (`.lake/scripts-lake.lock`): one build at a time in one worktree;
  2. snapshots (path, mtime, size) of every source file (`*.lean`, lakefile, manifest, toolchain, and
     the `input_file`s that modules read at elaboration time: everything under `asm/`);
  3. runs Lake against a private STAGING cache: `artifacts/` is a symlink to the shared one (artifacts
     are content-addressed and never rewritten -- harmless to share), `outputs/` (the input-hash ->
     artifact mappings, the only part that can be wrong) is a private copy;
  4. after the build re-snapshots the sources. Unchanged: new mappings are published into the shared
     `outputs/` (no-clobber, atomic link). Changed: NOTHING is published, the local Lake state of the
     changed modules is deleted (so the next build cannot trust it either), and the exit code is
     non-zero (3 if Lake itself succeeded) -- the build's result is not trustworthy, rerun it.
With LAKE_ARTIFACT_CACHE=false the build still takes the lock and gets the source check (a local trace
can be just as wrong; a later writing build would publish it), but nothing is staged or published; it
still READS the shared cache (Lake gets the variable unset: Lake's own `false` would disable reads too).
LAKE_COLD=1 keeps the shared cache out in both directions (Lake gets LAKE_ARTIFACT_CACHE=false): a worktree with
no `.lake/build` then compiles every module itself. Needed to see warnings: a module restored from the cache has
a synthetic trace with an EMPTY log ("log": []), so its warnings are neither stored nor replayed.
`env` and `serve` are passed through read-only (no lock, no writes). Plain `lake` bypasses all of this:
do not use it in a worktree (use LAKE_ARTIFACT_CACHE=false scripts/lake to keep the cache out).
"""
import json
import os
import shutil
import subprocess
import sys
import time
import fcntl
import secrets

STAGE_MAX_AGE = 12 * 3600  # a staging dir older than this is debris from a killed build


def toplevel():
    return subprocess.run(["git", "rev-parse", "--show-toplevel"], check=True,
                          capture_output=True, text=True).stdout.strip()


def truthy(v):
    return v.strip().lower() in ("1", "true", "yes", "y", "on")


def subcommand(args):
    for a in args:
        if not a.startswith("-"):
            return a
    return None


# Files (or directories of files, by their first path component) that modules read at elaboration
# time (Lake `input_file`s, `include_asm`), and the source directory of the library that `needs`
# them: a change to such a file during a build invalidates every module of that library (lane
# asmfile).
INPUT_DIRS = {"checker.s": "ConAguaAsm"}


def snapshot(root):
    """(mtime_ns, size) of every file that can change a module's input hash or its compilation."""
    snap = {}
    for dp, dn, fn in os.walk(root):
        dn[:] = [d for d in dn if d not in (".lake", "_tmp", ".git")]
        for f in fn:
            p = os.path.join(dp, f)
            top = os.path.relpath(p, root).split(os.sep)[0]
            if f.endswith(".lean") or f in ("lakefile.toml", "lakefile.lean",
                                            "lean-toolchain") or top in INPUT_DIRS:
                try:
                    st = os.stat(p)
                except FileNotFoundError:
                    continue
                snap[os.path.relpath(p, root)] = (st.st_mtime_ns, st.st_size)
    return snap


def invalidate(root, rel):
    """Delete Lake's local state (trace, outputs, .hash files) for the module whose source is `rel`
    (for an input file: for every module of the library that reads it)."""
    top = rel.split(os.sep)[0]
    if top in INPUT_DIRS:
        for dp, dn, fn in os.walk(os.path.join(root, INPUT_DIRS[top])):
            for f in fn:
                if f.endswith(".lean"):
                    invalidate(root, os.path.relpath(os.path.join(dp, f), root))
        return
    if not rel.endswith(".lean"):
        return
    invalidate_module(root, rel[:-len(".lean")])


def reconcile(root, shared):
    """Make this worktree's local build state agree with the shared cache. Lake (`getArtifacts?`,
    Lake/Build/Common.lean) prefers a module's LOCAL trace over the cache's mapping for the same input
    hash; Lean's oleans are not byte-for-byte deterministic, so a module compiled here while another
    worktree compiled (and published) the same input -- or compiled with the cache unreadable --
    keeps a different olean here, and every module downstream of it then gets an input hash (it
    contains the import oleans' hashes) that no other worktree has: they all miss the cache in the
    queue and elsewhere, and what this worktree publishes for them helps nobody (DESIGN.md, "Cache
    misses between worktrees"). So: wherever a local trace's input hash has a shared mapping with
    other outputs, delete the local state of that module; Lake then restores the shared outputs."""
    out = os.path.join(shared, "outputs", "ConAgua")
    lib = os.path.join(root, ".lake", "build", "lib", "lean")
    if not os.path.isdir(out) or not os.path.isdir(lib):
        return 0
    n = 0
    for dp, dn, fn in os.walk(lib):
        for f in fn:
            if not f.endswith(".trace"):
                continue
            try:
                with open(os.path.join(dp, f)) as fh:
                    t = json.load(fh)
                with open(os.path.join(out, f"{t['depHash']}.json")) as fh:
                    shared_outputs = json.load(fh)["data"]
            except (OSError, ValueError, KeyError, TypeError):
                continue  # no trace, no mapping (nothing to disagree with), or unreadable
            if t.get("outputs") is not None and shared_outputs != t["outputs"]:
                rel = os.path.relpath(os.path.join(dp, f[:-len(".trace")]), lib)
                invalidate_module(root, rel)
                n += 1
    return n


def invalidate_module(root, base):
    """Delete Lake's local state of the module whose path (without extension) is `base`."""
    for sub in ("lib/lean", "ir"):
        d = os.path.join(root, ".lake", "build", sub, os.path.dirname(base))
        stem = os.path.basename(base) + "."
        if not os.path.isdir(d):
            continue
        for f in os.listdir(d):
            if f.startswith(stem):
                try:
                    os.unlink(os.path.join(d, f))
                except FileNotFoundError:
                    pass


def publish(stage_out, shared_out, since):
    """Copy mappings Lake wrote into the staging outputs/ to the shared one, never overwriting."""
    new = conflicts = 0
    for dp, dn, fn in os.walk(stage_out):
        for f in fn:
            src = os.path.join(dp, f)
            if os.stat(src).st_mtime_ns < since:
                continue  # copied in at staging time, untouched by Lake
            dst = os.path.join(shared_out, os.path.relpath(src, stage_out))
            data = open(src, "rb").read()
            if os.path.exists(dst):
                if open(dst, "rb").read() != data:
                    conflicts += 1
                continue
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            tmp = f"{dst}.tmp-{os.getpid()}-{secrets.token_hex(4)}"
            with open(tmp, "wb") as fh:
                fh.write(data)
            try:
                os.link(tmp, dst)  # atomic, fails if another build published it meanwhile
                new += 1
            except FileExistsError:
                pass
            finally:
                os.unlink(tmp)
    return new, conflicts


def main():
    args = sys.argv[1:]
    root = toplevel()
    shared = os.path.realpath(os.path.join(root, "_tmp", "lake-cache-v2"))  # v2: DESIGN.md "Cache incident"
    env = dict(os.environ)
    env["LAKE_CACHE_DIR"] = shared
    env.setdefault("LAKE_RESTORE_ARTIFACTS", "true")
    # The user session has a 50 GB memory cap shared by every agent and build; a full rebuild at
    # Lake's default parallelism (one job per core, 96 here) reached it. LEAN_NUM_THREADS caps both
    # Lake's job pool and each lean's threads; set it explicitly to override.
    env.setdefault("LEAN_NUM_THREADS", "16")
    cold = truthy(env.get("LAKE_COLD", "false"))
    writes = truthy(env.get("LAKE_ARTIFACT_CACHE", "true")) and not cold
    sub = subcommand(args)
    if sub in (None, "env", "serve", "help"):
        env.pop("LAKE_ARTIFACT_CACHE", None)  # Lake's default: read the cache, never write it
        os.execvpe("lake", ["lake"] + args, env)
    if cold:
        # neither reads nor writes the shared cache (Lake's own `false`): every module is built here,
        # so its log (the warnings) is real; see LAKE_COLD in the docstring
        env["LAKE_ARTIFACT_CACHE"] = "false"
    elif not writes:
        # read-only: still locked and checked below, no staging. UNSET, not "false": Lake's
        # LAKE_ARTIFACT_CACHE=false turns off cache READS too (Package.isArtifactCacheReadable,
        # Lake/Config/Monad.lean); unset, reading is on and writing off.
        env.pop("LAKE_ARTIFACT_CACHE", None)

    os.makedirs(os.path.join(root, ".lake"), exist_ok=True)
    lockf = open(os.path.join(root, ".lake", "scripts-lake.lock"), "w")
    try:
        fcntl.flock(lockf, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print(f"scripts/lake: waiting for another scripts/lake in {root} to finish...", file=sys.stderr)
        fcntl.flock(lockf, fcntl.LOCK_EX)

    diverged = reconcile(root, shared)
    if diverged:
        print(f"scripts/lake: {diverged} module(s) here had other outputs than the shared cache has for the "
              f"same input; using the cache's", file=sys.stderr)

    stage = None
    if writes:
        stages = os.path.join(root, "_tmp", "lake-stage")
        os.makedirs(stages, exist_ok=True)
        now = time.time()
        for d in os.listdir(stages):
            p = os.path.join(stages, d)
            try:
                if now - os.stat(p).st_mtime > STAGE_MAX_AGE:
                    shutil.rmtree(p, ignore_errors=True)
            except FileNotFoundError:
                pass
        stage = os.path.join(stages, f"{os.getpid()}-{secrets.token_hex(4)}")
        os.makedirs(stage)
    rc = 1
    try:
        if stage:
            os.makedirs(os.path.join(shared, "artifacts"), exist_ok=True)
            os.symlink(os.path.join(shared, "artifacts"), os.path.join(stage, "artifacts"))
            if os.path.isdir(os.path.join(shared, "outputs")):
                subprocess.run(["cp", "-rp", os.path.join(shared, "outputs"), os.path.join(stage, "outputs")],
                               check=True)
            env["LAKE_CACHE_DIR"] = stage
            env["LAKE_ARTIFACT_CACHE"] = "true"
        before = snapshot(root)
        since = time.time_ns()
        try:
            rc = subprocess.run(["lake"] + args, env=env).returncode
        except KeyboardInterrupt:
            rc = 130
        after = snapshot(root)
        changed = sorted(p for p in set(before) | set(after) if before.get(p) != after.get(p))
        if changed:
            # even without cache writes: Lake's local trace now vouches for a text it may not have compiled
            for p in changed:
                invalidate(root, p)
            print("\nscripts/lake: ERROR: source files changed WHILE Lake was building -- this build's "
                  "result is NOT trustworthy\n(Lake hashed one version and may have compiled another; "
                  "DESIGN.md \"Cache incident\"). Nothing was written to the shared cache; the local "
                  "build state of these modules was deleted. Rerun the build once nothing is editing "
                  "the tree:", file=sys.stderr)
            for p in changed[:30]:
                print(f"  {p}", file=sys.stderr)
            if len(changed) > 30:
                print(f"  ... and {len(changed) - 30} more", file=sys.stderr)
            if rc == 0:
                rc = 3
        elif stage and os.path.isdir(os.path.join(stage, "outputs")):
            new, conflicts = publish(os.path.join(stage, "outputs"), os.path.join(shared, "outputs"), since)
            if conflicts:
                print(f"scripts/lake: note: {conflicts} cache mapping(s) differ from the shared cache's "
                      f"(kept the shared ones)", file=sys.stderr)
    finally:
        if stage:
            shutil.rmtree(stage, ignore_errors=True)
    sys.exit(rc)

if __name__ == "__main__":
    main()
