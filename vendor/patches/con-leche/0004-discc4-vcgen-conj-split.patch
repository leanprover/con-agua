DiscC4: the two whnfCore memo lemmas moved here from KnotC (con-leche #572), so their
CSOK.*_hit_ws companions (the vcgen conjunction split since lean4#15487) move with them.

diff --git a/vendor/con-leche/ConLeche/Verify/Cached/DiscC4.lean b/vendor/con-leche/ConLeche/Verify/Cached/DiscC4.lean
index a9e1bd1708554f4ac329d4e7dee124bbbdc03ff7..1fae2b5e278fa55a413a391ef405080cde70538a 100644
--- a/vendor/con-leche/ConLeche/Verify/Cached/DiscC4.lean
+++ b/vendor/con-leche/ConLeche/Verify/Cached/DiscC4.lean
@@ -449,6 +449,14 @@ theorem CSOK.whnfCore_hit (henv : EnvWF env) {s : CState} {d : Nat} {i r : Expr}
   exact ⟨⟨F, hrun⟩, whnfCore_WScoped henv F hrun hw⟩
 grind_pattern [conleche_grind] CSOK.whnfCore_hit =>
   CSOK mode eager env s, s.whnfCoreC[i]?, Runs ((fueledFns mode eager env).whnfCore false d i) r
+-- con-agua patch (nightly-2026-10-06+, lean4#15487): `vcgen` now splits the
+-- postcondition's `∧`, so the `WScoped` VC no longer contains the `Runs` term
+-- that triggers `CSOK.whnfCore_hit`; this conjunct gets its own trigger.
+theorem CSOK.whnfCore_hit_ws (henv : EnvWF env) {s : CState} {d : Nat} {i r : Expr}
+    (hs : CSOK mode eager env s) (hl : s.whnfCoreC[i]? = some r) (hw : Expr.WScoped d i) :
+    Expr.WScoped d r := (CSOK.whnfCore_hit henv hs hl hw).2
+grind_pattern [conleche_grind] CSOK.whnfCore_hit_ws =>
+  CSOK mode eager env s, s.whnfCoreC[i]?, Expr.WScoped d r
 
