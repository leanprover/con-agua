# The checker binary is built from four files at the repository root:
#   main.c     the trusted C harness (reads the input, maps the region, calls ca_start once)
#   checker.s  the compiled checker (generated by the verified compiler, committed)
#   pins.bin   the pin data, embedded by main.c (generated, committed)
#   reasons.h  the messages of the abort reasons, included by main.c (generated, committed)
# `make` needs only a C compiler with C23 `#embed` (GCC >= 15, Clang >= 19) and an x86-64 Linux
# assembler; no Lean.

CC ?= cc
CFLAGS ?= -O2

checker: main.c checker.s pins.bin reasons.h
	$(CC) -std=gnu23 $(CFLAGS) -pthread -o $@ main.c checker.s

# A smoke test: the prelude (a small export) is accepted (exit 0), a malformed line is not
# (exit 3, `ok 1`).
PRELUDE = vendor/con-leche/pins/leanprover-lean4-v4.35.0.prelude.ndjson
check: checker
	./checker $(PRELUDE)
	printf 'not json\n' > checker-smoke.ndjson
	./checker checker-smoke.ndjson; test $$? = 3
	rm -f checker-smoke.ndjson
	@echo "make check: ok"

# Regenerate checker.s and pins.bin from the Lean sources: needs the Lean toolchain (elan, the
# version in lean-toolchain) and builds what it needs with scripts/lake; reasons.h (and the Lean
# constants of the reasons) from scripts/reasons.tsv. `make regen-check` fails if a committed file
# is stale.
regen:
	python3 scripts/reasons.py
	python3 scripts/asm_file.py

regen-check:
	python3 scripts/reasons.py --check
	python3 scripts/asm_file.py --check

clean:
	rm -f checker checker-smoke.ndjson

.PHONY: check regen regen-check clean
