@[expose] public section

/-!
# `instantiateLift` in L (lanes `whnf3`, `ronsync3`)

con-ron's `instantiateLiftGo`/`instantiateLiftFast` (`Arena/ExprOps.lean`, con-leche's
`instantiateLift`, the cached `instantiateLiftXP`/`instantiateLiftC`): replace `bvar (d + j)` by
value `j` lifted past the `d` binders crossed (`liftLooseBVarsFast fuel d 0 v` at the leaf, lane
`exprops`' `lift_entry`), lower the loose `bvar`s above the values by their count, memoized per
`(node, depth)` in the twin's `inst1LC`: the memo library's table at word array `ILFM` (51,
stamp/count `CTL[52]`/`CTL[53]`), cleared on entry and exit as the twin.

The values `vs` (PUSH order, as `instantiateList`'s: the twin's `vs[i - d]` FROM THE END) are the
`IW` slice `(o, l)` (`LPIW`, the work pool): `bvar x` with `d ≤ x < d + l` reads entry
`l - 1 - (x - d)`; `bvar x` with `x ≥ d + l` becomes `bvar (x - l)`. The walk writes no `IW` word.

`i1l_go(h, d, o, l, fu)`: `abort` at `fu = 0` (the twin's `fuel` exhausted), the cutoff
`bvar_b(fu - 1, h) ≤ d` (the twin's `bvarB fuel h` at its decremented fuel), the view checks of
every tag (the twin views every node past the cutoff; a dangling handle aborts), the `bvar` arm
inline, the leaves returned as they are, the compound arms at `fu - 1`; the arms probe the memo,
rebuild through the store (`mk_*`), record. `instantiate_lift_fast(f, e, o, l, d)`: lane `induct`'s
convention, the fuel word `f` the walk's counter. At a value leaf `lift_entry` gets the walk's
remaining fuel `fu - 1`, as the twin's `liftLooseBVarsFast fuel d 0 v`.

The models `i1lW`/`i1l*W`/`i1lFastW` and the specs `i1lGo_spec`/`i1lFast_spec` are generated by
`l_model`; `WalkLiftRefine.lean` proves the refinement.
-/

set_option experimental.vcgen true

open Std.WP
open scoped Lean.Order

namespace L.Arena

abbrev i1lSch : MemoSch := ⟨ILFM, 52⟩

/-- con-ron: ConRon/Arena/ExprOps.lean:1902-1931 ConRon.Arena.instantiateLiftGo -/
@[no_expose, l_impl ConRon.Arena.instantiateLiftGo]
def i1lGo : FunDecl := lfn (h, d, o, l, fu) locals (x, g, t, i, r) {
  if fu == 0 { abort };
  x := call bvar_b(fu - 1, h);
  if x <= d { return h };
  g := ⟦h⟧.tag;
  t := ⟦h⟧.tier;
  i := ⟦h⟧.idx;
  if t != 0 && CTL.u64[1] == 0 { abort };
  if g == 0 {
    if BVAR⟨t⟩.count <= i { abort };
    x := BVAR⟨t, i⟩.i;
    if x < d { return h };
    if x - d < l { r := call lift_entry(LPIW.u64[o + (l - 1 - (x - d))], d, 0, fu - 1); return r };
    r := call intern_bvar(x - l);
    return r
  };
  if g == 1 { if FVAR⟨t⟩.count <= i { abort }; return h };
  if g == 2 { if SORT⟨t⟩.count <= i { abort }; return h };
  if g == 3 { if CONST⟨t⟩.count <= i { abort }; return h };
  if g == 8 { if LIT⟨t⟩.count <= i { abort }; return h };
  if g == 4 { i := ⟦h⟧.aidx; if APP⟨t⟩.count <= i { abort }; r := call i1l_app(h, d, o, l, fu - 1); return r };
  if g == 5 { if LAM⟨t⟩.count <= i { abort }; r := call i1l_lam(h, d, o, l, fu - 1); return r };
  if g == 6 { if FORALL⟨t⟩.count <= i { abort }; r := call i1l_forall(h, d, o, l, fu - 1); return r };
  if g == 7 { if LET⟨t⟩.count <= i { abort }; r := call i1l_let(h, d, o, l, fu - 1); return r };
  if g == 9 { if PROJ⟨t⟩.count <= i { abort }; r := call i1l_proj(h, d, o, l, fu - 1); return r };
  abort
}

/-- con-ron: ConRon/Arena/ExprOps.lean:1933-1945 ConRon.Arena.instLiftArmApp -/
@[no_expose, l_impl ConRon.Arena.instLiftArmApp]
def i1lApp : FunDecl := lfn (h, d, o, l, fu) locals (fd, j, e0, t, i, f, a, x, y, r, u) {
  (fd, j, e0) := call i1l_find(h, d);
  if fd != 0 { return ILFM.u64[j * 4 + 3] };
  t := ⟦h⟧.tier;
  i := ⟦h⟧.aidx;
  f := APP⟨t, i⟩.f;
  a := APP⟨t, i⟩.a;
  x := call i1l_go(f, d, o, l, fu);
  y := call i1l_go(a, d, o, l, fu);
  r := call mk_app(x, y);
  (fd, j, e0) := call i1l_find(h, d);
  u := call i1l_put(h, d, r, fd, j);
  return r
}

/-- con-ron: ConRon/Arena/ExprOps.lean:1947-1959 ConRon.Arena.instLiftArmLam -/
@[no_expose, l_impl ConRon.Arena.instLiftArmLam]
def i1lLam : FunDecl := lfn (h, d, o, l, fu) locals (fd, j, e0, t, i, f, a, x, y, r, u) {
  if d + 1 == 0 { abort };
  (fd, j, e0) := call i1l_find(h, d);
  if fd != 0 { return ILFM.u64[j * 4 + 3] };
  t := ⟦h⟧.tier;
  i := ⟦h⟧.idx;
  f := LAM⟨t, i⟩.ty;
  a := LAM⟨t, i⟩.b;
  x := call i1l_go(f, d, o, l, fu);
  y := call i1l_go(a, d + 1, o, l, fu);
  r := call mk_lam(x, y);
  (fd, j, e0) := call i1l_find(h, d);
  u := call i1l_put(h, d, r, fd, j);
  return r
}

/-- con-ron: ConRon/Arena/ExprOps.lean:1961-1973 ConRon.Arena.instLiftArmForallE -/
@[no_expose, l_impl ConRon.Arena.instLiftArmForallE]
def i1lForall : FunDecl := lfn (h, d, o, l, fu) locals (fd, j, e0, t, i, f, a, x, y, r, u) {
  if d + 1 == 0 { abort };
  (fd, j, e0) := call i1l_find(h, d);
  if fd != 0 { return ILFM.u64[j * 4 + 3] };
  t := ⟦h⟧.tier;
  i := ⟦h⟧.idx;
  f := FORALL⟨t, i⟩.ty;
  a := FORALL⟨t, i⟩.b;
  x := call i1l_go(f, d, o, l, fu);
  y := call i1l_go(a, d + 1, o, l, fu);
  r := call mk_forall(x, y);
  (fd, j, e0) := call i1l_find(h, d);
  u := call i1l_put(h, d, r, fd, j);
  return r
}

/-- con-ron: ConRon/Arena/ExprOps.lean:1975-1988 ConRon.Arena.instLiftArmLet -/
@[no_expose, l_impl ConRon.Arena.instLiftArmLet]
def i1lLet : FunDecl := lfn (h, d, o, l, fu) locals (fd, j, e0, t, i, f, a, b, x, y, z, r, u) {
  if d + 1 == 0 { abort };
  (fd, j, e0) := call i1l_find(h, d);
  if fd != 0 { return ILFM.u64[j * 4 + 3] };
  t := ⟦h⟧.tier;
  i := ⟦h⟧.idx;
  f := LET⟨t, i⟩.ty;
  a := LET⟨t, i⟩.v;
  b := LET⟨t, i⟩.b;
  x := call i1l_go(f, d, o, l, fu);
  y := call i1l_go(a, d, o, l, fu);
  z := call i1l_go(b, d + 1, o, l, fu);
  r := call mk_let(x, y, z);
  (fd, j, e0) := call i1l_find(h, d);
  u := call i1l_put(h, d, r, fd, j);
  return r
}

/-- con-ron: ConRon/Arena/ExprOps.lean:1990-2001 ConRon.Arena.instLiftArmProj -/
@[no_expose, l_impl ConRon.Arena.instLiftArmProj]
def i1lProj : FunDecl := lfn (h, d, o, l, fu) locals (fd, j, e0, t, i, nm, ix, e, x, r, u) {
  (fd, j, e0) := call i1l_find(h, d);
  if fd != 0 { return ILFM.u64[j * 4 + 3] };
  t := ⟦h⟧.tier;
  i := ⟦h⟧.idx;
  nm := PROJ⟨t, i⟩.n;
  ix := PROJ⟨t, i⟩.i;
  e := PROJ⟨t, i⟩.e;
  x := call i1l_go(e, d, o, l, fu);
  r := call mk_proj(nm, ix, x);
  (fd, j, e0) := call i1l_find(h, d);
  u := call i1l_put(h, d, r, fd, j);
  return r
}

/-- con-ron: ConRon/Arena/ExprOps.lean:2035-2041 ConRon.Arena.instantiateLiftFast -/
@[no_expose, l_impl ConRon.Arena.instantiateLiftFast]
def i1lFast : FunDecl := lfn (f, e, o, l, d) locals (r, u) {
  u := call i1l_clear();
  r := call i1l_go(e, d, o, l, f);
  u := call i1l_clear();
  return r & 4294967295
}

/-- The walk's own functions (with `inst_prog`'s and `lift_entry`'s callees). -/
def i1lFns : Prog :=
  [("i1l_find", memoFindG i1lSch), ("i1l_put", memoPutG i1lSch), ("i1l_clear", memoClearG i1lSch),
   ("i1l_go", i1lGo), ("i1l_app", i1lApp), ("i1l_lam", i1lLam), ("i1l_forall", i1lForall),
   ("i1l_let", i1lLet), ("i1l_proj", i1lProj), ("instantiate_lift_fast", i1lFast)]

/-! ## The models and the specs (generated, lane `tails`) -/

/-- What the specs need of the program. -/
structure I1lProg (p : Prog) : Prop where
  bvb : BvbProg p
  lift : LiftProg p
  le : p.lookup "lift_entry" = some liftEntry
  find : p.lookup "i1l_find" = some (memoFindG i1lSch)
  put : p.lookup "i1l_put" = some (memoPutG i1lSch)
  clear : p.lookup "i1l_clear" = some (memoClearG i1lSch)
  go : p.lookup "i1l_go" = some i1lGo
  app : p.lookup "i1l_app" = some i1lApp
  lam : p.lookup "i1l_lam" = some i1lLam
  fa : p.lookup "i1l_forall" = some i1lForall
  lt : p.lookup "i1l_let" = some i1lLet
  pj : p.lookup "i1l_proj" = some i1lProj
  fast : p.lookup "instantiate_lift_fast" = some i1lFast

/-- **`i1l_go` and its arms are their models** `i1lW`, `i1lAppW`, …, at every fuel. -/
l_model i1lGo_spec (p : Prog) (hp : I1lProg p)
  fns [hp.go ↦ i1lW, hp.app ↦ i1lAppW, hp.lam ↦ i1lLamW, hp.fa ↦ i1lForallW,
    hp.lt ↦ i1lLetW, hp.pj ↦ i1lProjW]
  specs [bvarBL_spec p hp.bvb n, liftEntry_spec p hp.lift hp.le n,
    internBVar_spec p (hp.lift.get "bvar_find") (hp.lift.get "bvar_push") (hp.lift.get "intern_bvar") n,
    memoFindG_spec i1lSch p _ hp.find n, memoPutG_spec i1lSch p _ hp.put n,
    mkApp_spec p (hp.lift.get "der_b") (hp.lift.get "app_find") (hp.lift.get "app_push") (hp.lift.get "intern_app") (hp.lift.get "mk_app") n,
    mkLam_spec p (hp.lift.get "der_b") (hp.lift.get "lam_find") (hp.lift.get "lam_push") (hp.lift.get "intern_lam") (hp.lift.get "mk_lam") n,
    mkForall_spec p (hp.lift.get "der_b") (hp.lift.get "forall_find") (hp.lift.get "forall_push") (hp.lift.get "intern_forall") (hp.lift.get "mk_forall") n,
    mkLet_spec p (hp.lift.get "der_b") (hp.lift.get "letE_find") (hp.lift.get "letE_push") (hp.lift.get "intern_letE") (hp.lift.get "mk_let") n,
    mkProj_spec p (hp.lift.get "der_b") (hp.lift.get "proj_find") (hp.lift.get "proj_push") (hp.lift.get "intern_proj") (hp.lift.get "mk_proj") n]
  grind [arena_grind] fold [tierW, idxW]
  extra [evalE_tld, tld, evalE_cnt, tcntM, evalE_tierE, evalE_idxE, evalE_idxAE, evalE_idxGE, evalE_tagE]
  finish [tierW, idxW] gen 20 heartbeats 1000000

/-- **`instantiate_lift_fast` is its model `i1lFastW`** (generated). -/
l_model i1lFast_spec (p : Prog) (hp : I1lProg p)
  fns [hp.fast ↦ i1lFastW]
  specs [memoClearG_spec i1lSch p _ hp.clear n, (i1lGo_spec p hp n).1]
  grind [arena_grind]

end L.Arena
