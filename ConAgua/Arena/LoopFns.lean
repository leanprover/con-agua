/-!
# The declaration loop's call closure and its write set (lane `loopt2`)

`loopFns`: every function the jobs (`check_jobs`: `record_job`, `check_decl`)
reach in the checker's program (the bracket, the arms, the core, the stage), as a literal computed from
`checkerProg`'s call graph (1481 names; the decided check in `ConAgua/Checker/LoopAll.lean`
fails if a callee is missing, then recompute it). No function of it writes the pin table or a
byte array, and every `CTL` word it writes is below 1024 (`LoopClosed`): a step of the loop keeps
the pin table, so the pin flag, and every array's size.
-/

open ConRon.Arena

namespace L.Arena

/-- The arrays the loop may write: all but the pin table. -/
def loopA : List TieredArray := checkerWordArrays.filter (· ≠ PINS)

/-- The `CTL` words the loop may write. -/
def loopC : List Word := (List.range 1024).map UInt64.ofNat

theorem loopA_pins : (PINS : TieredArray) ∉ loopA := by simp [loopA]

