/-- `lp_rb_let`: `h` when the three children came back equal, else `mk_let`, checked. -/
theorem ilwRbLet_eq (p : Prog) (n : Nat) (m : Mem) (h f a b x y z : Word) :
    ilwRbLet p (n + 1) m h f a b x y z =
      if (x = f ∧ y = a) ∧ z = b then some (h, m) else ilwChk (callW p n "mk_let" [x, y, z] m) := by
  have hj : ilwRbLet.j1 p n x y z m = ilwChk (callW p n "mk_let" [x, y, z] m) := by
    simp only [ilwRbLet.j1]
    cases callW p n "mk_let" [x, y, z] m with
    | none => rfl
    | some q => obtain ⟨r, m₁⟩ := q; simp [ilwRbLet.k_mk_let, ilwChk]
  by_cases h1 : x = f ∧ y = a
  · by_cases h2 : z = b
    · rw [ilwRbLet.arm1 p n m h f a b x y z h1 h2, ite_eq_left ⟨h1, h2⟩]
    · rw [ilwRbLet.arm2 p n m h f a b x y z h1 h2, hj, ite_eq_right (fun hh => h2 hh.2)]
  · rw [ilwRbLet.arm3 p n m h f a b x y z h1, hj, ite_eq_right (fun hh => h1 hh.1)]

