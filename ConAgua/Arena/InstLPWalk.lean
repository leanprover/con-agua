/-- The generated memo write is the hand `ilwSetK`. -/
theorem ilwSetK_j1 (h r : Word) (m : Mem) :
    (if mfindG lpSch m h 0 = [] then none else
      (fun o : Option Mem => match o with | none => none | some m₁ => some (r, m₁))
        (mputG lpSch m h 0 r ((mfindG lpSch m h 0).headD 0) ((mfindG lpSch m h 0).tail.headD 0))) =
      ilwSetK h (some (r, m)) := by
  simp only [ilwSetK, msetG]
  split <;> try rfl

/-- **`lp_fvar`'s model as the probe, the child, the rebuild, the memo write** (the refinement's shape). -/
theorem ilwFVarW_eq (p : Prog) (n : Nat) (m : Mem) (h ko kc vo vc fu : Word) :
    ilwFVarW p (n + 1) m h ko kc vo vc fu = ilwProbe m h (ilwSetK h
      (match callW p n "lp_go" [tfld m FVAR (tierW h) (idxW h) 1, ko, kc, vo, vc, fu] m with
        | none => none
        | some (x, m₁) => if x.headD 0 = tfld m FVAR (tierW h) (idxW h) 1 then some (h, m₁)
            else ilwChk (callW p n "intern_fvar" [tfld m FVAR (tierW h) (idxW h) 0, x.headD 0] m₁))) := by
  rw [ilwFVarW.eq_2]; unfold ilwProbe
  split <;> try rfl
  split <;> try rfl
  cases callW p n "lp_go" [tfld m FVAR (tierW h) (idxW h) 1, ko, kc, vo, vc, fu] m with
  | none => rfl
  | some q =>
    obtain ⟨x, m₁⟩ := q
    simp only [ilwFVarW.k_lp_go]
    split
    · exact ilwSetK_j1 h h m₁
    · cases callW p n "intern_fvar" [tfld m FVAR (tierW h) (idxW h) 0, x.headD 0] m₁ with
      | none => rfl
      | some q =>
        obtain ⟨y, m₂⟩ := q
        simp only [ilwFVarW.k_intern_fvar, ilwChk]
        split
        · rfl
        · exact ilwSetK_j1 h _ m₂

